{
  "name": "rea-web-backend",
  "version": "0.1.0",
  "description": "Web RE Engine — Backend API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start:prod": "NODE_ENV=production tsx src/app.ts",
    "set-password": "tsx scripts/set-password.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "marked": "^18.1.1",
    "multer": "^1.4.5-lts.1",
    "playwright-core": "1.58.2",
    "rea-agents": "6.3.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
